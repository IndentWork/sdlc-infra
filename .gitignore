# Terraform local state and cache — never commit these
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfplan

# terraform.tfvars may contain secrets — gitignored
# terraform.auto.tfvars holds non-sensitive env config and IS committed
terraform.tfvars
!terraform.auto.tfvars
!*.tfvars.example

# OS
.DS_Store
